# PostgreSQL Database Connection URL (Drizzle ORM)
DATABASE_URL=postgresql://user:password@localhost:5432/ticket_radar

# LLM Chat & Structured Reasoning (78Code / OpenAI compatible)
OPENAI_API_KEY=your_openai_or_78code_api_key
OPENAI_BASE_URL=https://www.78code.cc/v1
OPENAI_MODEL=gpt-5.6-terra

# Dense Vector Embedding (Baishanyun / OpenAI compatible)
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.edgefn.net/v1
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker Model (Baishanyun / Cohere compatible)
RERANK_API_KEY=your_rerank_api_key
RERANK_BASE_URL=https://api.edgefn.net/v1
RERANK_MODEL=bge-reranker-v2-m3
