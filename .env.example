# ============================================================
# 12345 工单平台 - 环境变量模板
# ============================================================
# 用法:
#   本地开发:  cp .env.example .env.local  (gitignore 不 commit)
#              编辑 .env.local, app 自动读 (Next.js / drizzle)
#   VPS 部署:  cp .env.example .env.vps    (gitignore 不 commit)
#              编辑 .env.vps 填真实密钥, docker compose --env-file .env.vps up -d
#
# ⚠️ 永远不要 commit .env.local 或 .env.vps (含真实密钥)
# ⚠️ .env.vps 必须含 POSTGRES_PASSWORD (postgres image 不接受空密码, 否则容器不停 restart)
# ============================================================

# ---------- Postgres ----------
DATABASE_URL=postgresql://postgres:***@localhost:5432/ticket_radar

# ---------- LLM Chat: DeepSeek (替代 78code) ----------
# 申请: https://platform.deepseek.com/
OPENAI_API_KEY=sk-<yo…key>
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ---------- Embedding: Baishanyun (edgefn, OpenAI 兼容) ----------
# 申请: https://api.edgefn.net/
EMBEDDING_API_KEY=sk-<yo…key>
EMBEDDING_BASE_URL=https://api.edgefn.net/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- Rerank: Baishanyun (同 embedding key) ----------
RERANK_API_KEY=sk-<yo…key>
RERANK_BASE_URL=https://api.edgefn.net/v1
RERANK_MODEL=bge-reranker-v2-m3

# ---------- Better Auth ----------
BETTER_AUTH_SECRET=civic-12345-auth-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# ---------- Better Auth: 默认系统管理员 (pnpm db:seed-admin 读取) ----------
# 本地开发可用默认值 (admin / admin)。生产部署务必覆盖 ADMIN_PASSWORD 为高强度密码:
#   ADMIN_PASSWORD=$(openssl rand -hex 12)
ADMIN_EMAIL=admin@civic.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---------- Next.js runtime ----------
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
