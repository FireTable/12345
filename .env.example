# ============================================================
# 12345 工单平台 - 环境变量模板
# ============================================================
# 用法:
#   本地开发:  cp .env.example .env.local  (gitignore 不 commit)
#              编辑 .env.local, app 自动读 (Next.js / drizzle)
#   VPS 部署:  cp .env.example .env.vps    (gitignore 不 commit)
#              编辑 .env.vps 填真实密钥, docker compose --env-file .env.vps up -d
#
# ⚠️ 永远不要 commit .env.local 或 .env.vps (含真实密钥)
# ⚠️ .env.vps 必须含 POSTGRES_PASSWORD (postgres image 不接受空密码, 否则容器不停 restart)
# ============================================================

# ---------- Postgres ----------
DATABASE_URL=postgresql://postgres:***@localhost:5432/ticket_radar

# ---------- 本地 System 2（抽取、主题建议、副驾驶）----------
# 不写则默认 http://127.0.0.1:8132/v1。多节点用逗号分隔。
# SYSTEM_TWO_ENDPOINTS=http://127.0.0.1:8132/v1

# ---------- 云端回退与 AI 拓荒 ----------
# 本地 System 2 探活失败且写了 Key 时，getSystemTwoEngine 才用这三行。
# 向量客户端没写 EMBEDDING_API_KEY 时也会读 OPENAI_API_KEY。
# 主模型仍是本地 27B 与 BAAI/bge-m3，不要把这里当成对话主通道。
OPENAI_API_KEY=sk-<yo…key>
OPENAI_BASE_URL=https://api.edgefn.net/v1
OPENAI_MODEL=DeepSeek-V4-Flash-0731

# ---------- Embedding: Baishanyun (edgefn, OpenAI 兼容) ----------
# 申请: https://api.edgefn.net/
EMBEDDING_API_KEY=sk-<yo…key>
EMBEDDING_BASE_URL=https://api.edgefn.net/v1
EMBEDDING_MODEL=BAAI/bge-m3
# 不写 EMBEDDING_ENDPOINTS 时，研判用上面的 EMBEDDING_BASE_URL。
# 要本机 bge-m3 加云端备用时才写这个，逗号分隔。本地地址不休眠；名单里有云端时，429 才退避。
# 权重用 pnpm embed:pull，只下载 F16，不启动进程。
# EMBEDDING_ENDPOINTS=http://127.0.0.1:8133/v1,https://api.edgefn.net/v1
# bulk：Mac 回填，batch 32。online：单条，batch 4。
EMBEDDING_PROFILE=bulk

# ---------- Rerank: Baishanyun (同 embedding key) ----------
RERANK_API_KEY=sk-<yo…key>
RERANK_BASE_URL=https://api.edgefn.net/v1
RERANK_MODEL=bge-reranker-v2-m3

# ---------- Better Auth ----------
BETTER_AUTH_SECRET=civic-12345-auth-secret-key-change-in-production
BETTER_AUTH_URL=http://localhost:3000

# ---------- Better Auth: 默认系统管理员 (pnpm db:seed-admin 读取) ----------
# 本地开发可用默认值 (admin / admin)。生产部署务必覆盖 ADMIN_PASSWORD 为高强度密码:
#   ADMIN_PASSWORD=$(openssl rand -hex 12)
ADMIN_EMAIL=admin@civic.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---------- Next.js runtime ----------
NODE_ENV=development
PORT=3000
NEXT_TELEMETRY_DISABLED=1

# ---------- 地理信息/地图服务: 天地图 (Tianditu) ----------
# 申请入口: https://console.tianditu.gov.cn/
# 申请说明: 创建应用 -> 类型选择「服务端应用」(获取 Server Key, 用于后端代理瓦片与正逆地理编码)
# 免费配额: 个人认证 10,000 次/天，企业认证 30,000 次/天 (国家自然资源部公益地理服务，无商用版权费用)
# ⚠️ 安全原则: 仅服务端读取(/api/map/*)，切勿使用 NEXT_PUBLIC_ 前缀，杜绝浏览器前端泄露
TIANDITU_SERVER_KEY=your_tianditu_server_key_here
NEXT_PUBLIC_TIANDITU_TK=your_tianditu_frontend_key_here

# ---------- LLM 推理服务 (本地 gguf 模型 + llama.cpp) ----------
# pnpm dev:llm 启动 serve.ts 时通过 --env-file-if-exists=.env.local 读这两个变量。
# 默认 serve.ts 查找顺序：env > 包内 bin/ > 工作区 bin/ > 系统 PATH > macOS 默认
# brew 的 llama.cpp (PATH 上) 跟项目原本期望的 prismml 版本不一致时容易撞上 GGML type 兼容问题，
# 显式设 LLAMA_SERVER_BIN 指向本地构建的二进制可绕开。请改成你机器上的真实路径。
# LLAMA_SERVER_BIN=/path/to/llama-server
# BONSAI_MODEL_PATH=/path/to/your-model.gguf

